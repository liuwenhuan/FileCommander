#pragma once

// Generated from the top-level CMakeLists project(... VERSION ...) via
// configure_file(). Edit src/version.h.in, never the generated copy in the
// build tree. Consumed by the About dialog and the online-update checker.
#define TTC_VERSION "@PROJECT_VERSION@"
#define TTC_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define TTC_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define TTC_VERSION_PATCH @PROJECT_VERSION_PATCH@

// Where the online updater looks for its release manifest. Set at configure
// time with -DFILECOMMANDER_UPDATE_MANIFEST_URL=...; see docs/UPDATE_SERVER.md.
// The default is deliberately unreachable so an unconfigured build never talks
// to a host somebody else controls.
#define TTC_UPDATE_MANIFEST_URL "@FILECOMMANDER_UPDATE_MANIFEST_URL@"

// Root URL of the account server backing sign-in and device-to-device
// transfers (see server/README.md). Set at configure time with
// -DFILECOMMANDER_ACCOUNT_API_URL=...; the environment variable of the same
// name overrides it at runtime so a build can be pointed at a local server.
// The default is deliberately unreachable, so an unconfigured build never
// sends credentials to a host somebody else controls.
#define TTC_ACCOUNT_API_URL "@FILECOMMANDER_ACCOUNT_API_URL@"
