{
  "profile": "windows-full-portable",
  "packageType": "portable",
  "features": {
    "pdfPreview": true,
    "mediaPreview": true
  },
  "groups": {
    "application": { "required": ["FileCommander.exe"], "forbidden": [] },
    "qt": { "required": ["Qt5Core.dll", "Qt5Gui.dll", "Qt5Widgets.dll", "Qt5Xml.dll"], "forbidden": [] },
    "platformPlugins": { "required": ["platforms/qwindows.dll"], "forbidden": [] },
    "imagePlugins": { "required": [], "forbidden": [] },
    "network": { "required": [], "forbidden": [] },
    "pdf": { "required": ["poppler-qt5.dll", "poppler.dll", "freetype.dll", "openjp2.dll", "libpng16.dll"], "forbidden": [] },
    "media": { "required": ["libmpv-2.dll"], "forbidden": [] },
    "office": { "required": [], "forbidden": [] },
    "msvcRuntime": { "required": ["vcruntime140.dll", "vcruntime140_1.dll", "msvcp140.dll"], "forbidden": [] }
  }
}
