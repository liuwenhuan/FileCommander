<RCC>
    <qresource prefix="/themes">
        <file alias="light.qss">themes/light.qss</file>
        <file alias="dark.qss">themes/dark.qss</file>
        <file alias="green.qss">themes/green.qss</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="branch-closed-light.svg">icons/branch-closed-light.svg</file>
        <file alias="branch-open-light.svg">icons/branch-open-light.svg</file>
        <file alias="branch-closed-dark.svg">icons/branch-closed-dark.svg</file>
        <file alias="branch-open-dark.svg">icons/branch-open-dark.svg</file>
        <file alias="branch-closed-green.svg">icons/branch-closed-green.svg</file>
        <file alias="branch-open-green.svg">icons/branch-open-green.svg</file>
        <file alias="ext-connect.svg">icons/ext-connect.svg</file>
        <file alias="eject.svg">icons/eject.svg</file>
        <file alias="refresh.svg">icons/refresh.svg</file>
        <file alias="notepad.svg">icons/notepad.svg</file>
        <file alias="dev-usb.svg">icons/dev-usb.svg</file>
        <file alias="dev-drive.svg">icons/dev-drive.svg</file>
        <file alias="dev-hdd.svg">icons/dev-hdd.svg</file>
        <file alias="dev-phone.svg">icons/dev-phone.svg</file>
        <file alias="dev-sdcard.svg">icons/dev-sdcard.svg</file>
        <file alias="dev-smb.svg">icons/dev-smb.svg</file>
        <file alias="dev-sftp.svg">icons/dev-sftp.svg</file>
        <file alias="dev-ftp.svg">icons/dev-ftp.svg</file>
        <file alias="dev-webdav.svg">icons/dev-webdav.svg</file>
        <file alias="crt-scan-screen.png">icons/crt-scan-screen.png</file>
        <file alias="crt-scan-chrome.png">icons/crt-scan-chrome.png</file>
        <file alias="crt-scan-sunken.png">icons/crt-scan-sunken.png</file>
    </qresource>
    <qresource prefix="/translations">
        <file alias="ttc_zh_CN.qm">translations/ttc_zh_CN.qm</file>
        <file alias="ttc_zh_TW.qm">translations/ttc_zh_TW.qm</file>
        <file alias="ttc_fr.qm">translations/ttc_fr.qm</file>
        <file alias="ttc_de.qm">translations/ttc_de.qm</file>
        <file alias="ttc_es.qm">translations/ttc_es.qm</file>
        <file alias="ttc_ru.qm">translations/ttc_ru.qm</file>
        <file alias="ttc_ja.qm">translations/ttc_ja.qm</file>
        <file alias="ttc_ko.qm">translations/ttc_ko.qm</file>
        <file alias="ttc_pt_BR.qm">translations/ttc_pt_BR.qm</file>
    </qresource>
</RCC>
