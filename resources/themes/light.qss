/* Light theme -- covers the whole UI (panels, dialogs, status bar,
   error messages), not just menus. */

QWidget {
    background-color: #f5f5f5;
    color: #202020;
    selection-background-color: #3d7deb;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #f5f5f5;
}

QMenuBar {
    background-color: #ececec;
    border-bottom: 1px solid #d0d0d0;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #3d7deb;
    color: #ffffff;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #c8c8c8;
}

QLabel[semanticState="error"] {
    color: #c0392b;
}

QLabel[semanticState="warning"] {
    color: #9a6700;
}

QLabel[semanticState="muted"] {
    color: #6b7280;
}

QMenu QWidget[menuChromeSurface="true"] {
    background: transparent;
}

/* ...and the labels inside it. The universal QWidget rule above paints every
   widget, so a caption in an embedded menu row came out as a grey block on the
   menu's own background. The row's - / + buttons are deliberately NOT included:
   they are controls, and the fill is what makes them read as pressable. */
QMenu QWidget[menuChromeSurface="true"] QLabel {
    background: transparent;
}

QMenu::item {
    padding: 4px 24px;
}

QMenu::item:selected {
    background-color: #3d7deb;
    color: #ffffff;
}

QToolBar {
    background-color: #ececec;
    border: none;
    spacing: 2px;
}

QToolBar QToolButton {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}

QToolBar QToolButton:hover {
    background-color: #dcdcdc;
}

TitleBar QToolButton#TitleMenuButton {
    background: transparent;
    color: #202020;
    padding: 4px 8px;
}

TitleBar QToolButton#TitleMenuButton:hover {
    background-color: #dcdcdc;
}

TitleBar QToolButton#TitleMenuButton::menu-indicator {
    image: none;
}

TitleBar QLabel {
    background: transparent;
}

QTableView {
    background-color: #ffffff;
    color: #202020;
    /* No zebra striping: every row uses the same background (matches dark mode). */
    alternate-background-color: #ffffff;
    gridline-color: #e0e0e0;
    border: 1px solid #d0d0d0;
    /* Selection colours are set on the widget (not via a ::item pseudo-element)
       so QStyleSheetStyle folds them into the palette. FileItemDelegate then
       paints cells directly from the palette on the fast native path, instead
       of routing every cell through the slow per-cell CSS box model -- which
       was what made an interactive column/splitter resize lag. */
    selection-background-color: #3d7deb;
    selection-color: #ffffff;
}

/* Inactive panel: softer selection so the active panel's row stands out. The
   [panelActive] property is toggled (+re-polished) in FileListView, which swaps
   the palette Highlight the delegate reads. */
QTableView[panelActive="false"] {
    selection-background-color: #c3d4f0;
    selection-color: #202020;
}

/* Tree views (the directory tree, and the function-key picker's command list).
   Without these the platform style supplies its own row colours, which is how
   the picker ended up with a stock blue selection regardless of theme. */
QTreeView {
    background-color: #ffffff;
    color: #202020;
    alternate-background-color: #ffffff;
    border: 1px solid #d0d0d0;
    selection-background-color: #3d7deb;
    selection-color: #ffffff;
}

QTreeView::item:hover:!selected {
    background-color: #e8eefb;
    color: #202020;
}

QHeaderView::section {
    background-color: #ececec;
    color: #202020;
    padding: 4px;
    border: none;
    border-right: 1px solid #d0d0d0;
    border-bottom: 1px solid #d0d0d0;
    font-weight: normal;
}

PlainHeaderView {
    qproperty-sectionBackground: #ececec;
    qproperty-sectionForeground: #202020;
    qproperty-sectionBorder: #d0d0d0;
}

/* The F4 editor's line-number gutter is hand-painted, so no background-color
   rule can reach it. These name its colours outright -- see the class note in
   src/viewer/TextEditor.h. Selector is the subclass, not QPlainTextEdit: a
   qproperty- rule warns on stderr for every matched widget that lacks the
   property. */
CodeEditor {
    qproperty-gutterBackground: #ececec;
    qproperty-gutterForeground: #909090;
    qproperty-gutterBorder: #d0d0d0;
}

/* The hex view's address column is the same idea as the gutter above, and it
   had the same bug: its default came from AlternateBase, a palette role no
   theme here sets, so it painted a white strip down the left of a dark
   window. Named explicitly, and matched to the gutter so the two views read
   as one editor. */
HexEditor {
    qproperty-addressBackgroundColor: #ececec;
    qproperty-addressColor: #909090;
    qproperty-separatorColor: #d0d0d0;
}

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
    padding: 3px 6px;
}

QLineEdit:focus {
    border: 1px solid #3d7deb;
}

/* No border at rest. Nothing else in the address row has one either -- the
   tree toggle, back/forward and star button are all flat -- so a box around
   the breadcrumb was the only line in the row and read as a stray frame.
   (There used to be a second one: an overlay drew the row's own left/right
   edges. It went for the same reason.) Only the editing state gets a border,
   as a "you're now typing a path" cue. */
BreadcrumbBar[editing="true"] {
    border: 1px solid #3d7deb;
    border-radius: 0;
}

BreadcrumbBar QWidget#BreadcrumbDisplay,
BreadcrumbBar QWidget#BreadcrumbSegments,
BreadcrumbBar QWidget#BreadcrumbViewport {
    background: transparent;
    border: none;
}

BreadcrumbBar QLineEdit {
    border: none;
    border-radius: 0;
    margin: 0;
}

BreadcrumbBar QToolButton#BreadcrumbScrollLeft,
BreadcrumbBar QToolButton#BreadcrumbScrollRight {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

/* Numeric editors need their own rule: the platform spin-box frame otherwise
   overrides the line-edit palette and can render its value like disabled text. */
QAbstractSpinBox {
    background-color: #ffffff;
    color: #202020;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
    padding: 3px 20px 3px 6px;
    selection-background-color: #3d7deb;
    selection-color: #ffffff;
}

QAbstractSpinBox:hover {
    border-color: #a8a8a8;
}

QAbstractSpinBox:focus {
    border-color: #3d7deb;
}

QAbstractSpinBox:disabled {
    background-color: #ececec;
    color: #8a8a8a;
    border-color: #d0d0d0;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    background-color: #e4e4e4;
    border-left: 1px solid #c8c8c8;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-bottom: 1px solid #c8c8c8;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #d6d6d6;
}

/* Combo boxes -- flat box + flat popup that matches the theme. Without these
   rules Qt falls back to the native platform style: a 3D/protruding drop-down
   and a popup whose text colour ignores the app theme. */
QComboBox {
    background-color: #ffffff;
    color: #202020;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
    padding: 2px 6px;
}

QComboBox:focus {
    border: 1px solid #3d7deb;
}

QComboBox:hover {
    border: 1px solid #a8a8a8;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 18px;
    border: none;
    background: transparent;
}

/* The dropdown list. selection-* keep the highlighted row on-theme; the flat
   1px border replaces the native raised frame. */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #202020;
    border: 1px solid #c8c8c8;
    outline: none;
    selection-background-color: #3d7deb;
    selection-color: #ffffff;
}

/* Colour the item text on the ::item sub-control itself. Under DTK the
   view-level `color` above only reaches the *selected* row; non-selected rows
   fall back to the (light) palette Text role and render invisible on white,
   so the per-item colour has to be spelled out here. */
QComboBox QAbstractItemView::item {
    color: #202020;
    padding: 3px 8px;
    min-height: 20px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #3d7deb;
    color: #ffffff;
}

QPushButton {
    background-color: #e4e4e4;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 5px 10px;
}

QPushButton:hover {
    background-color: #d6d6d6;
}

QPushButton:pressed {
    background-color: #c4c4c4;
}

QTableWidget#ShortcutTable QKeySequenceEdit,
QTableWidget#ShortcutTable QKeySequenceEdit QLineEdit {
    background: transparent;
    border: none;
    padding: 0;
}

QToolButton#PanelAddTabButton {
    background: transparent;
    color: #202020;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 0;
}

QToolButton#PanelAddTabButton:hover {
    background: #d6d6d6;
    border-color: #c8c8c8;
}

QToolButton#PanelAddTabButton:pressed {
    background: #c4c4c4;
    border-color: #b6b6b6;
}

QToolButton#PanelAddTabButton:disabled {
    background: transparent;
    color: #a0a0a0;
    border-color: transparent;
}

QWidget#PanelAddressRow QToolButton {
    background: transparent;
    color: #202020;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 0;
}

QWidget#PanelAddressRow QToolButton:hover {
    background: #d6d6d6;
    border-color: #c8c8c8;
}

QWidget#PanelAddressRow QToolButton:pressed {
    background: #c4c4c4;
    border-color: #b6b6b6;
}

QWidget#PanelAddressRow QToolButton:disabled {
    background: transparent;
    color: #a0a0a0;
    border-color: transparent;
}

QWidget#PanelAddressRow QToolButton:checked {
    background: #3d7deb;
    color: #ffffff;
    border-color: #2f6fd4;
}

QWidget#PanelAddressRow QToolButton:checked:hover {
    background: #2f6fd4;
    color: #ffffff;
    border-color: #245fc0;
}

QWidget#PanelAddressRow QToolButton:checked:pressed {
    background: #245fc0;
    color: #ffffff;
    border-color: #1f52a8;
}

QTabBar::tab {
    background-color: #e4e4e4;
    border: 1px solid #c8c8c8;
    border-bottom: none;
    padding: 5px 12px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

/* Active tab is not highlighted by background; TabBar paints a thick accent
   line along its top edge instead. Keep the same look as an inactive tab. */
QTabBar::tab:selected {
    background-color: #e4e4e4;
    color: #202020;
}

QTabBar QToolButton {
    background: #f4f4f4;
    color: #202020;
    border: 1px solid #c8c8c8;
    padding: 0;
}

QTabBar QToolButton:hover {
    background: #d6d6d6;
    border-color: #c8c8c8;
}

QTabBar QToolButton:pressed {
    background: #c4c4c4;
    border-color: #b6b6b6;
}

QTabBar QToolButton:disabled {
    background: #f4f4f4;
    color: #a0a0a0;
    border-color: #c8c8c8;
}

QStatusBar {
    background-color: #ececec;
    border-top: 1px solid #d0d0d0;
}

QProgressBar {
    background-color: #e4e4e4;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #3d7deb;
}

QMessageBox {
    background-color: #f5f5f5;
}

QScrollBar:vertical {
    width: 12px;
    background: #ececec;
    border: none;
}

QScrollBar:horizontal {
    height: 12px;
    background: #ececec;
    border: none;
}

QScrollBar::handle:vertical {
    background: #c0c0c0;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:horizontal {
    background: #c0c0c0;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:hover {
    background: #a8a8a8;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: #ececec;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    background: #ececec;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    background: #ececec;
}

/* Directory-tree expand/collapse arrows. Dark-tinted SVGs so every branch
   arrow stays legible and consistent against the light background,
   regardless of row/selection state. */
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url(:/icons/branch-closed-dark.svg);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    border-image: none;
    image: url(:/icons/branch-open-dark.svg);
}

/* External-connection fly-out: a floating panel anchored above its function-key
   button. Rounded top corners + a blue accent border, with no bottom border so
   it merges with the button it grows out of. */
#ExternalConnectPanel {
    background-color: #f5f5f5;
    border: 1px solid #3d7deb;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
#ExternalConnectPanel QListWidget#ExternalConnectList {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    outline: none;
}
#ExternalConnectPanel QListWidget#ExternalConnectList::item {
    padding: 4px 6px;
    border-radius: 3px;
    color: #303030;
}
#ExternalConnectPanel QListWidget#ExternalConnectList::item:hover {
    background-color: #e6e6e6;
}
#ExternalConnectPanel QListWidget#ExternalConnectList::item:selected {
    background-color: #3d7deb;
    color: #ffffff;
}
#ExternalConnectPanel QListWidget#ExternalConnectList QScrollBar:vertical {
    width: 7px;
    background: transparent;
    margin: 0;
}
#ExternalConnectPanel QListWidget#ExternalConnectList QScrollBar::add-line:vertical,
#ExternalConnectPanel QListWidget#ExternalConnectList QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}

/* Cloud Clipboard fly-out: same anchored-popup treatment as the external-connect
   panel (rounded top, accent border, bottom-flush). Split top list / bottom editor. */
#CloudClipboardPanel {
    background-color: #f5f5f5;
    border: 1px solid #3d7deb;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
#CloudClipboardPanel QListWidget#CloudClipboardList {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    outline: none;
}
#CloudClipboardPanel QListWidget#CloudClipboardList::item {
    padding: 4px 6px;
    border-radius: 3px;
    color: #303030;
}
#CloudClipboardPanel QListWidget#CloudClipboardList::item:hover {
    background-color: #e6e6e6;
}
#CloudClipboardPanel QListWidget#CloudClipboardList::item:selected {
    background-color: #3d7deb;
    color: #ffffff;
}
#CloudClipboardPanel QPlainTextEdit#CloudClipboardEditor {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    color: #303030;
}
#CloudClipboardPanel QSplitter#CloudClipboardSplitter::handle {
    background-color: #cfcfcf;
}

/* Notepad list: a thin scrollbar shown only when the list can't fit (i.e. the
   popup has hit the app-top ceiling). Handle colour inherits the global rule. */
#CloudClipboardPanel QListWidget#CloudClipboardList QScrollBar:vertical {
    width: 7px;
    background: transparent;
    margin: 0;
}
#CloudClipboardPanel QListWidget#CloudClipboardList QScrollBar::add-line:vertical,
#CloudClipboardPanel QListWidget#CloudClipboardList QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}

/* These are plain QWidget subclasses that now set Qt::WA_StyledBackground, so
   that the CRT theme can give them its scanline texture. That attribute also
   makes them paint THIS sheet's `QWidget { background-color }`, which they did
   not before -- they showed whatever was behind them. Spelling out
   `transparent` restores exactly that, so this theme looks unchanged. */
FilePanel, TitleBar, FunctionKeyBar, CommandBar, BreadcrumbBar, StatusBarWidget {
    background: transparent;
}

/* One frame around the whole command bar -- the directory prompt and the
   editor are a single control, so the border belongs to the bar, not to the
   editor inside it. The editor keeps its focus colour by lighting the bar. */
CommandBar {
    border: 1px solid #c8c8c8;
    border-radius: 3px;
}

CommandBar QLineEdit#CommandInput {
    border: none;
    border-radius: 0;
    background: transparent;
}

CommandBar[inputFocused="true"] {
    border: 1px solid #3d7deb;
}

/* The preview's floating info panel (image and video both). It used to carry an
   inline white-on-black stylesheet, which is the one thing in the pane that
   never noticed which theme was on -- and an inline sheet also wins over this
   one, so it had to come off the widget entirely. Nearly opaque: it sits over a
   photograph or a video frame and has to stay readable against anything. */
QLabel#quickViewInfoOverlay,
QLabel#quickViewVideoInfoOverlay {
    background: rgba(245, 245, 245, 235);
    color: #202020;
    border: 1px solid #c8c8c8;
    padding: 6px;
    border-radius: 4px;
}

/* Media sliders (preview seek and volume). Left unstyled they fell back to the
   platform style -- a dotted grey groove that belongs to no theme at all. Same
   parts as the scrollbars above, so the played portion reads as a filled
   channel rather than a stock track. */
QSlider::groove:horizontal {
    height: 6px;
    background: #e4e4e4;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
}

QSlider::groove:vertical {
    width: 6px;
    background: #e4e4e4;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
}

QSlider::sub-page:horizontal, QSlider::add-page:vertical {
    background: #3d7deb;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
}

QSlider::add-page:horizontal, QSlider::sub-page:vertical {
    background: #e4e4e4;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid #9a9a9a;
    width: 10px;
    /* Negative margin so the handle overhangs the 6px groove instead of being
       clipped to it. */
    margin: -5px 0;
    border-radius: 5px;
}

QSlider::handle:vertical {
    background: #ffffff;
    border: 1px solid #9a9a9a;
    height: 10px;
    margin: 0 -5px;
    border-radius: 5px;
}

QSlider::handle:hover {
    border-color: #3d7deb;
}

QSlider::sub-page:horizontal:disabled, QSlider::add-page:vertical:disabled {
    background: #d0d0d0;
}

QSlider::handle:horizontal:disabled, QSlider::handle:vertical:disabled {
    background: #f0f0f0;
    border-color: #c8c8c8;
}

/* Tabbed preview (Office documents): QTabBar is themed above, but the pane
   behind it kept the platform's own frame. */
QTabWidget::pane {
    background: #f5f5f5;
    border: 1px solid #c8c8c8;
}

/* Framed views that were left on the platform's own frame: dialog lists, the
   image preview's scroll area, and the PDF/slides pages. Same values as
   QTreeView above so a list in a dialog matches the directory tree.
   QListWidget rather than QListView on purpose -- IconFileView is a QListView
   and has its own rule, which a generic one would override. */
QListWidget, QScrollArea, QGraphicsView {
    background-color: #ffffff;
    color: #202020;
    border: 1px solid #d0d0d0;
    selection-background-color: #3d7deb;
    selection-color: #ffffff;
}
