/* Light theme -- covers the whole UI (panels, dialogs, status bar,
   error messages), not just menus. */

QWidget {
    background-color: #f5f5f5;
    color: #202020;
    selection-background-color: #3d7deb;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #f5f5f5;
}

QMenuBar {
    background-color: #ececec;
    border-bottom: 1px solid #d0d0d0;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #3d7deb;
    color: #ffffff;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #c8c8c8;
}

QMenu::item {
    padding: 4px 24px;
}

QMenu::item:selected {
    background-color: #3d7deb;
    color: #ffffff;
}

QToolBar {
    background-color: #ececec;
    border: none;
    spacing: 2px;
}

QToolBar QToolButton {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}

QToolBar QToolButton:hover {
    background-color: #dcdcdc;
}

QTableView {
    background-color: #ffffff;
    color: #202020;
    /* No zebra striping: every row uses the same background (matches dark mode). */
    alternate-background-color: #ffffff;
    gridline-color: #e0e0e0;
    border: 1px solid #d0d0d0;
    /* Selection colours are set on the widget (not via a ::item pseudo-element)
       so QStyleSheetStyle folds them into the palette. FileItemDelegate then
       paints cells directly from the palette on the fast native path, instead
       of routing every cell through the slow per-cell CSS box model -- which
       was what made an interactive column/splitter resize lag. */
    selection-background-color: #3d7deb;
    selection-color: #ffffff;
}

/* Inactive panel: softer selection so the active panel's row stands out. The
   [panelActive] property is toggled (+re-polished) in FileListView, which swaps
   the palette Highlight the delegate reads. */
QTableView[panelActive="false"] {
    selection-background-color: #c3d4f0;
    selection-color: #202020;
}

QHeaderView::section {
    background-color: #ececec;
    color: #202020;
    padding: 4px;
    border: none;
    border-right: 1px solid #d0d0d0;
    border-bottom: 1px solid #d0d0d0;
    font-weight: normal;
}

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
    padding: 3px 6px;
}

QLineEdit:focus {
    border: 1px solid #3d7deb;
}

/* Combo boxes -- flat box + flat popup that matches the theme. Without these
   rules Qt falls back to the native platform style: a 3D/protruding drop-down
   and a popup whose text colour ignores the app theme. */
QComboBox {
    background-color: #ffffff;
    color: #202020;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
    padding: 2px 6px;
}

QComboBox:focus {
    border: 1px solid #3d7deb;
}

QComboBox:hover {
    border: 1px solid #a8a8a8;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 18px;
    border: none;
    background: transparent;
}

/* The dropdown list. selection-* keep the highlighted row on-theme; the flat
   1px border replaces the native raised frame. */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #202020;
    border: 1px solid #c8c8c8;
    outline: none;
    selection-background-color: #3d7deb;
    selection-color: #ffffff;
}

/* Colour the item text on the ::item sub-control itself. Under DTK the
   view-level `color` above only reaches the *selected* row; non-selected rows
   fall back to the (light) palette Text role and render invisible on white,
   so the per-item colour has to be spelled out here. */
QComboBox QAbstractItemView::item {
    color: #202020;
    padding: 3px 8px;
    min-height: 20px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #3d7deb;
    color: #ffffff;
}

QPushButton {
    background-color: #e4e4e4;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 5px 10px;
}

QPushButton:hover {
    background-color: #d6d6d6;
}

QPushButton:pressed {
    background-color: #c4c4c4;
}

QTabBar::tab {
    background-color: #e4e4e4;
    border: 1px solid #c8c8c8;
    border-bottom: none;
    padding: 5px 12px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

/* Active tab is not highlighted by background; TabBar paints a thick accent
   line along its top edge instead. Keep the same look as an inactive tab. */
QTabBar::tab:selected {
    background-color: #e4e4e4;
    color: #202020;
}

QStatusBar {
    background-color: #ececec;
    border-top: 1px solid #d0d0d0;
}

QProgressBar {
    background-color: #e4e4e4;
    border: 1px solid #c8c8c8;
    border-radius: 3px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #3d7deb;
}

QMessageBox {
    background-color: #f5f5f5;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #ececec;
    border: none;
}

QScrollBar::handle {
    background: #c0c0c0;
    border-radius: 4px;
}

QScrollBar::handle:hover {
    background: #a8a8a8;
}
