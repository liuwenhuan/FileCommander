/* Dark theme -- covers the whole UI (panels, dialogs, status bar,
   error messages), not just menus.

   The accent is a neutral slate rather than a bright blue. Once the file
   list's icons and thumbnails follow the theme (Image Colours Follow Theme),
   the grid is greyscale, and a #3d7deb selection tile and up-arrow were the
   only saturated things on screen -- they read as leftovers rather than as
   accents. Two values, by role: #565b63 fills, dark enough to carry white
   text, and #8e949c lines, light enough to read as a focus ring on #2b2b2b. */

QWidget {
    background-color: #2b2b2b;
    color: #e0e0e0;
    selection-background-color: #565b63;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #2b2b2b;
}

QMenuBar {
    background-color: #232323;
    border-bottom: 1px solid #1a1a1a;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #565b63;
    color: #ffffff;
}

QMenu {
    background-color: #333333;
    border: 1px solid #1a1a1a;
}

QLabel[semanticState="error"] {
    color: #e04a4a;
}

QLabel[semanticState="warning"] {
    color: #e0a040;
}

QLabel[semanticState="muted"] {
    color: #9a9a9a;
}

QMenu QWidget[menuChromeSurface="true"] {
    background: transparent;
}

/* ...and the labels inside it. The universal QWidget rule above paints every
   widget, so a caption in an embedded menu row came out as a grey block on the
   menu's own background. The row's - / + buttons are deliberately NOT included:
   they are controls, and the fill is what makes them read as pressable. */
QMenu QWidget[menuChromeSurface="true"] QLabel {
    background: transparent;
}

QMenu::item {
    padding: 4px 24px;
}

QMenu::item:selected {
    background-color: #565b63;
    color: #ffffff;
}

QToolBar {
    background-color: #232323;
    border: none;
    spacing: 2px;
}

QToolBar QToolButton {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
    color: #e0e0e0;
}

QToolBar QToolButton:hover {
    background-color: #3a3a3a;
}

TitleBar QToolButton#TitleMenuButton {
    background: transparent;
    color: #e0e0e0;
    padding: 4px 8px;
}

TitleBar QToolButton#TitleMenuButton:hover {
    background-color: #3a3a3a;
}

TitleBar QToolButton#TitleMenuButton::menu-indicator {
    image: none;
}

TitleBar QLabel {
    background: transparent;
}

QTableView {
    background-color: #232323;
    color: #e0e0e0;
    /* No zebra striping in dark mode: every row uses the same dark background. */
    alternate-background-color: #232323;
    gridline-color: #3a3a3a;
    border: 1px solid #1a1a1a;
    /* Selection colours on the widget (not a ::item rule) so they fold into the
       palette; FileItemDelegate paints cells directly from it on the fast path
       instead of the slow per-cell CSS box model. See light.qss for the why. */
    selection-background-color: #565b63;
    selection-color: #ffffff;
}

/* Inactive panel: softer selection so the active panel's row stands out. */
QTableView[panelActive="false"] {
    selection-background-color: #37455f;
    selection-color: #c8c8c8;
}

/* Tree views (the directory tree, and the function-key picker's command list).
   Without these the platform style supplies its own row colours, which is how
   the picker ended up with a stock blue selection in an otherwise dark dialog. */
QTreeView {
    background-color: #232323;
    color: #e0e0e0;
    alternate-background-color: #232323;
    border: 1px solid #1a1a1a;
    selection-background-color: #565b63;
    selection-color: #ffffff;
}

QTreeView::item:hover:!selected {
    background-color: #2f3d52;
    color: #e0e0e0;
}

QHeaderView::section {
    background-color: #232323;
    color: #e0e0e0;
    padding: 4px;
    border: none;
    border-right: 1px solid #1a1a1a;
    border-bottom: 1px solid #1a1a1a;
    font-weight: normal;
}

PlainHeaderView {
    qproperty-sectionBackground: #232323;
    qproperty-sectionForeground: #e0e0e0;
    qproperty-sectionBorder: #505050;
}

QLineEdit {
    background-color: #232323;
    color: #e0e0e0;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 3px 6px;
}

QLineEdit:focus {
    border: 1px solid #8e949c;
}

/* No border at rest. Nothing else in the address row has one either -- the
   tree toggle, back/forward and star button are all flat -- so a box around
   the breadcrumb was the only line in the row and read as a stray frame.
   (There used to be a second one: an overlay drew the row's own left/right
   edges. It went for the same reason.) Only the editing state gets a border,
   as a "you're now typing a path" cue. */
BreadcrumbBar[editing="true"] {
    border: 1px solid #8e949c;
    border-radius: 0;
}

BreadcrumbBar QWidget#BreadcrumbDisplay,
BreadcrumbBar QWidget#BreadcrumbSegments,
BreadcrumbBar QWidget#BreadcrumbViewport {
    background: transparent;
    border: none;
}

BreadcrumbBar QLineEdit {
    border: none;
    border-radius: 0;
    margin: 0;
}

BreadcrumbBar QToolButton#BreadcrumbScrollLeft,
BreadcrumbBar QToolButton#BreadcrumbScrollRight {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

QAbstractSpinBox {
    background-color: #232323;
    color: #e0e0e0;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 3px 20px 3px 6px;
    selection-background-color: #565b63;
    selection-color: #ffffff;
}

QAbstractSpinBox:hover {
    border-color: #555555;
}

QAbstractSpinBox:focus {
    border-color: #8e949c;
}

QAbstractSpinBox:disabled {
    background-color: #2b2b2b;
    color: #777777;
    border-color: #383838;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    background-color: #3a3a3a;
    border-left: 1px solid #444444;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-bottom: 1px solid #444444;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #454545;
}

/* Combo boxes -- flat box + flat popup that matches the theme. Without these
   rules Qt falls back to the native platform style: a 3D/protruding drop-down
   and a popup whose text colour ignores the app theme. */
QComboBox {
    background-color: #232323;
    color: #e0e0e0;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 2px 6px;
}

QComboBox:focus {
    border: 1px solid #8e949c;
}

QComboBox:hover {
    border: 1px solid #555555;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 18px;
    border: none;
    background: transparent;
}

/* The dropdown list. selection-* keep the highlighted row on-theme; the flat
   1px border replaces the native raised frame. */
QComboBox QAbstractItemView {
    background-color: #333333;
    color: #e0e0e0;
    border: 1px solid #1a1a1a;
    outline: none;
    selection-background-color: #565b63;
    selection-color: #ffffff;
}

/* Spell the item text colour out on the ::item sub-control -- under DTK the
   view-level `color` only reaches the selected row, so non-selected rows need
   their colour set here to stay on-theme. */
QComboBox QAbstractItemView::item {
    color: #e0e0e0;
    padding: 3px 8px;
    min-height: 20px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #565b63;
    color: #ffffff;
}

QPushButton {
    background-color: #3a3a3a;
    color: #e0e0e0;
    border: 1px solid #4a4a4a;
    border-radius: 4px;
    padding: 5px 10px;
}

QPushButton:hover {
    background-color: #454545;
}

QPushButton:pressed {
    background-color: #2f2f2f;
}

QTableWidget#ShortcutTable QKeySequenceEdit,
QTableWidget#ShortcutTable QKeySequenceEdit QLineEdit {
    background: transparent;
    border: none;
    padding: 0;
}

QToolButton#PanelAddTabButton {
    background: transparent;
    color: #e0e0e0;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 0;
}

QToolButton#PanelAddTabButton:hover {
    background: #454545;
    border-color: #555555;
}

QToolButton#PanelAddTabButton:pressed {
    background: #2f2f2f;
    border-color: #383838;
}

QToolButton#PanelAddTabButton:disabled {
    background: transparent;
    color: #777777;
    border-color: transparent;
}

QWidget#PanelAddressRow QToolButton {
    background: transparent;
    color: #e0e0e0;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 0;
}

QWidget#PanelAddressRow QToolButton:hover {
    background: #454545;
    border-color: #555555;
}

QWidget#PanelAddressRow QToolButton:pressed {
    background: #2f2f2f;
    border-color: #383838;
}

QWidget#PanelAddressRow QToolButton:disabled {
    background: transparent;
    color: #777777;
    border-color: transparent;
}

QWidget#PanelAddressRow QToolButton:checked {
    background: #565b63;
    color: #ffffff;
    border-color: #2f6fd4;
}

QWidget#PanelAddressRow QToolButton:checked:hover {
    background: #2f6fd4;
    color: #ffffff;
    border-color: #245fc0;
}

QWidget#PanelAddressRow QToolButton:checked:pressed {
    background: #245fc0;
    color: #ffffff;
    border-color: #1f52a8;
}

QTabBar::tab {
    background-color: #3a3a3a;
    color: #e0e0e0;
    border: 1px solid #1a1a1a;
    border-bottom: none;
    padding: 5px 12px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

/* Active tab is not highlighted by background; TabBar paints a thick accent
   line along its top edge instead. Keep the same look as an inactive tab. */
QTabBar::tab:selected {
    background-color: #3a3a3a;
    color: #e0e0e0;
}

QTabBar QToolButton {
    background: #2b2b2b;
    color: #e0e0e0;
    border: 1px solid #1a1a1a;
    padding: 0;
}

QTabBar QToolButton:hover {
    background: #454545;
    border-color: #555555;
}

QTabBar QToolButton:pressed {
    background: #2f2f2f;
    border-color: #383838;
}

QTabBar QToolButton:disabled {
    background: #2b2b2b;
    color: #777777;
    border-color: #1a1a1a;
}

QStatusBar {
    background-color: #232323;
    border-top: 1px solid #1a1a1a;
    color: #e0e0e0;
}

QProgressBar {
    background-color: #3a3a3a;
    border: 1px solid #1a1a1a;
    border-radius: 3px;
    text-align: center;
    color: #e0e0e0;
}

QProgressBar::chunk {
    background-color: #565b63;
}

QMessageBox {
    background-color: #2b2b2b;
}

QScrollBar:vertical {
    width: 12px;
    background: #232323;
    border: none;
}

QScrollBar:horizontal {
    height: 12px;
    background: #232323;
    border: none;
}

QScrollBar::handle:vertical {
    background: #4a4a4a;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:horizontal {
    background: #4a4a4a;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:hover {
    background: #5a5a5a;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: #232323;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    background: #232323;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    background: #232323;
}

/* Directory-tree expand/collapse arrows. The platform style draws these with
   its own (near-black) colour, which disappears against the dark background
   on some rows. Use light-tinted SVGs so every branch arrow is legible and
   consistent regardless of row/selection state. */
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url(:/icons/branch-closed-light.svg);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    border-image: none;
    image: url(:/icons/branch-open-light.svg);
}

/* External-connection fly-out: a floating panel anchored above its function-key
   button. Rounded top corners + a blue accent border, with no bottom border so
   it merges with the button it grows out of. */
#ExternalConnectPanel {
    background-color: #2b2b2b;
    border: 1px solid #8e949c;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
#ExternalConnectPanel QListWidget#ExternalConnectList {
    background-color: #262626;
    border: 1px solid #1a1a1a;
    border-radius: 4px;
    outline: none;
}
#ExternalConnectPanel QListWidget#ExternalConnectList::item {
    padding: 4px 6px;
    border-radius: 3px;
    color: #e0e0e0;
}
#ExternalConnectPanel QListWidget#ExternalConnectList::item:hover {
    background-color: #3a3a3a;
}
#ExternalConnectPanel QListWidget#ExternalConnectList::item:selected {
    background-color: #565b63;
    color: #ffffff;
}
#ExternalConnectPanel QListWidget#ExternalConnectList QScrollBar:vertical {
    width: 7px;
    background: transparent;
    margin: 0;
}
#ExternalConnectPanel QListWidget#ExternalConnectList QScrollBar::add-line:vertical,
#ExternalConnectPanel QListWidget#ExternalConnectList QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}

/* Quick-notepad fly-out: same anchored-popup treatment as the external-connect
   panel (rounded top, accent border, bottom-flush). Split top list / bottom editor. */
#NotepadPanel {
    background-color: #2b2b2b;
    border: 1px solid #8e949c;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
#NotepadPanel QListWidget#NotepadList {
    background-color: #262626;
    border: 1px solid #1a1a1a;
    border-radius: 4px;
    outline: none;
}
#NotepadPanel QListWidget#NotepadList::item {
    padding: 4px 6px;
    border-radius: 3px;
    color: #e0e0e0;
}
#NotepadPanel QListWidget#NotepadList::item:hover {
    background-color: #3a3a3a;
}
#NotepadPanel QListWidget#NotepadList::item:selected {
    background-color: #565b63;
    color: #ffffff;
}
#NotepadPanel QPlainTextEdit#NotepadEditor {
    background-color: #262626;
    border: 1px solid #1a1a1a;
    border-radius: 4px;
    color: #e0e0e0;
}
#NotepadPanel QSplitter#NotepadSplitter::handle {
    background-color: #3a3a3a;
}

/* Notepad list: a thin scrollbar shown only when the list can't fit (i.e. the
   popup has hit the app-top ceiling). Handle colour inherits the global rule. */
#NotepadPanel QListWidget#NotepadList QScrollBar:vertical {
    width: 7px;
    background: transparent;
    margin: 0;
}
#NotepadPanel QListWidget#NotepadList QScrollBar::add-line:vertical,
#NotepadPanel QListWidget#NotepadList QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}

/* These are plain QWidget subclasses that now set Qt::WA_StyledBackground, so
   that the CRT theme can give them its scanline texture. That attribute also
   makes them paint THIS sheet's `QWidget { background-color }`, which they did
   not before -- they showed whatever was behind them. Spelling out
   `transparent` restores exactly that, so this theme looks unchanged. */
FilePanel, TitleBar, FunctionKeyBar, CommandBar, BreadcrumbBar, StatusBarWidget {
    background: transparent;
}

/* See light.qss: the frame belongs to the bar, not to the editor inside it. */
CommandBar {
    border: 1px solid #444444;
    border-radius: 3px;
}

CommandBar QLineEdit#CommandInput {
    border: none;
    border-radius: 0;
    background: transparent;
}

CommandBar[inputFocused="true"] {
    border: 1px solid #8e949c;
}

/* The preview's floating info panel (image and video both). It used to carry an
   inline white-on-black stylesheet, which is the one thing in the pane that
   never noticed which theme was on -- and an inline sheet also wins over this
   one, so it had to come off the widget entirely. Nearly opaque: it sits over a
   photograph or a video frame and has to stay readable against anything. */
QLabel#quickViewInfoOverlay {
    background: rgba(43, 43, 43, 235);
    color: #e0e0e0;
    border: 1px solid #444444;
    padding: 6px;
    border-radius: 4px;
}
