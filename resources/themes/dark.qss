/* Dark theme -- covers the whole UI (panels, dialogs, status bar,
   error messages), not just menus. */

QWidget {
    background-color: #2b2b2b;
    color: #e0e0e0;
    selection-background-color: #3d7deb;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #2b2b2b;
}

QMenuBar {
    background-color: #232323;
    border-bottom: 1px solid #1a1a1a;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #3d7deb;
    color: #ffffff;
}

QMenu {
    background-color: #333333;
    border: 1px solid #1a1a1a;
}

QMenu::item {
    padding: 4px 24px;
}

QMenu::item:selected {
    background-color: #3d7deb;
    color: #ffffff;
}

QToolBar {
    background-color: #232323;
    border: none;
    spacing: 2px;
}

QToolBar QToolButton {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
    color: #e0e0e0;
}

QToolBar QToolButton:hover {
    background-color: #3a3a3a;
}

QTableView {
    background-color: #232323;
    alternate-background-color: #2a2f3a;
    gridline-color: #3a3a3a;
    border: 1px solid #1a1a1a;
    color: #e0e0e0;
}

QTableView::item:selected {
    background-color: #3d7deb;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #232323;
    color: #e0e0e0;
    padding: 4px;
    border: none;
    border-right: 1px solid #1a1a1a;
    border-bottom: 1px solid #1a1a1a;
}

QLineEdit {
    background-color: #232323;
    color: #e0e0e0;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 3px 6px;
}

QLineEdit:focus {
    border: 1px solid #3d7deb;
}

QPushButton {
    background-color: #3a3a3a;
    color: #e0e0e0;
    border: 1px solid #4a4a4a;
    border-radius: 4px;
    padding: 5px 10px;
}

QPushButton:hover {
    background-color: #454545;
}

QPushButton:pressed {
    background-color: #2f2f2f;
}

QTabBar::tab {
    background-color: #3a3a3a;
    color: #e0e0e0;
    border: 1px solid #1a1a1a;
    border-bottom: none;
    padding: 5px 12px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #3d7deb;
    color: #ffffff;
}

QStatusBar {
    background-color: #232323;
    border-top: 1px solid #1a1a1a;
    color: #e0e0e0;
}

QProgressBar {
    background-color: #3a3a3a;
    border: 1px solid #1a1a1a;
    border-radius: 3px;
    text-align: center;
    color: #e0e0e0;
}

QProgressBar::chunk {
    background-color: #3d7deb;
}

QMessageBox {
    background-color: #2b2b2b;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #232323;
    border: none;
}

QScrollBar::handle {
    background: #4a4a4a;
    border-radius: 4px;
}

QScrollBar::handle:hover {
    background: #5a5a5a;
}
